@@ -0,0 +1,89 @@
+import Image from "next/image";
+import { XM_AFFILIATE_URL, XM_AD_POINTS } from "@/lib/xm";
+
+// Sponsored XM slot rendered *inside* the body of a blog post — between
+// sections in the "inline" variant, and once more after the last section in
+// the "final" variant. This is separate from BrokerAdBanner (which rotates
+// through the whole sponsored pool at the top of the article) because these
+// slots are sold to one advertiser and always point at XM_AFFILIATE_URL.
+//
+// Both variants carry a visible "Sponsorlu" label and rel="sponsored" so the
+// unit is distinguishable from editorial content and declared to crawlers,
+// per affiliate-disclosure practice.
+
+type Variant = "inline" | "final";
+
+export default function XmInlineAd({ variant = "inline" }: { variant?: Variant }) {
+  if (variant === "inline") {
+    return (
+      <aside
+        aria-label="Sponsorlu içerik"
+        className="my-12 overflow-hidden rounded-2xl border border-hairline bg-ink text-text-on-ink"
+      >
+        <div className="flex flex-col gap-5 px-6 py-6 sm:flex-row sm:items-center sm:justify-between">
+          <div className="flex min-w-0 items-center gap-4">
+            <span className="relative flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-full bg-ink-soft">
+              <Image src="/brokers/xm.png" alt="XM Global logo" fill sizes="48px" className="object-contain p-1.5" />
+            </span>
+            <div className="min-w-0">
+              <span className="font-mono text-[10px] uppercase tracking-[0.2em] text-signal">Sponsorlu</span>
+              <p className="notranslate mt-0.5 font-poppins text-base font-semibold text-text-on-ink">XM Global</p>
+              <p className="mt-0.5 text-[13px] leading-snug text-text-on-ink-muted">
+                FXPARTNER ortak kodu ile açılan hesaplar nakit iadesi ve VIP ayrıcalıklara erişir.
+              </p>
+            </div>
+          </div>
+          <a
