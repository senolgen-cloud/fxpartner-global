# Neon Postgres connection string (Vercel Marketplace > Storage > Neon, or
# neon.tech directly) — required for member accounts, comments, complaints,
# and the cashback program. Without this, every request that touches auth()
# (including proxy.ts's /admin and /account gating) crashes at import time.
DATABASE_URL=

# Auth.js session/token signing secret. Generate one with:
# openssl rand -base64 32
AUTH_SECRET=

# Email address allowed into /admin/*, gated in src/proxy.ts. Defaults to
# senolgen@gmail.com if unset.
ADMIN_EMAIL=

# Resend (https://resend.com/api-keys) — sends the magic-link sign-in email
RESEND_API_KEY=

# Telegram bot (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Channel/group the bot posts to, e.g. @fxpartnerglobal or a numeric chat id
TELEGRAM_CHAT_ID=

# DeepL (free tier: https://www.deepl.com/pro-api) — used for faithful
# EN->TR translation of news headlines, never for "creative" rewriting
DEEPL_API_KEY=

# Upstash Redis (Vercel Marketplace > Storage > Redis) — tracks which
# news items have already been posted so we never repeat one
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Random string you choose yourself — Vercel Cron sends it back as a
# Bearer token so only real cron triggers (not the public internet) can
# hit /api/cron/*. Generate one with: openssl rand -hex 32
CRON_SECRET=

# Production site URL, used to build the chart image URL Telegram fetches
NEXT_PUBLIC_SITE_URL=https://fxpartner.global
